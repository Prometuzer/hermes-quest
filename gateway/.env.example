# Développement local : chemin vers Hermes Agent.
HERMES_BIN=hermes

# Production/Vercel : endpoint HTTPS privé d'un service Hermes sans outils.
# HERMES_UPSTREAM_URL=https://example.internal/v1/hermes-quest
# HERMES_UPSTREAM_TOKEN=replace-me

# Bêta privée uniquement. Une clé intégrée à un client public n'est pas secrète.
# GATEWAY_API_KEY=replace-me

GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
