# ============================================
# HERMES GATEWAY — Variables d'environnement
# ============================================
# Copie ce fichier en .env et adapte les valeurs.

# Binaire Hermes Agent (détecté automatiquement si dans le PATH)
# HERMES_BIN=/usr/local/bin/hermes

# Profil Hermes dédié au jeu (laisser vide = profil par défaut partagé avec Telegram)
# HERMES_GAME_PROFILE=game

# Port du pont FastAPI
GATEWAY_PORT=8000

# URL publique du pont (pour le déploiement prod)
# GATEWAY_PUBLIC_URL=https://gateway.tondomaine.com
