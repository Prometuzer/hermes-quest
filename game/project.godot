;
; HERMES: QUEST FOR THE CODEX SOUL
; Projet Godot 4.3 — Zelda-like 2D avec Gateway Hermes Agent
;

config_version=5

[application]

config/name="Hermes: Quest for the Codex Soul"
config/description="Aventure 2D où Hermes, jeune punk au casque audio, combat les IA malveillantes avec le Codex Soul V1. Inclut le Mode Gateway : parle à Hermes Agent depuis le jeu."
run/main_scene="res://scenes/world/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/sprites/hermes/icon.png"

[autoload]

Globals="*res://scripts/autoload/Globals.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/test_width=1280
window/size/test_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

